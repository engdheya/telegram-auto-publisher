# =============================================================================
# Telegram Auto Publisher — Environment Configuration Template
# Copy this file to `.env` and set secure values before running in production:
#   cp .env.example .env
# =============================================================================

# --- Application ---
APP_NAME="Telegram Auto Publisher"
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Security & Cryptography ---
# Generate JWT_SECRET_KEY with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE_48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Generate SESSION_ENCRYPTION_KEY (Fernet 32-byte urlsafe base64 key) with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=CHANGE_ME_GENERATE_FERNET_32_BYTE_BASE64_KEY

# --- Initial Bootstrap Admin Account (Created on first startup if users table is empty) ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD_123!

# --- Database & Storage ---
DATABASE_URL=sqlite:////home/user/telegram-auto-publisher/runtime/tap.db
BACKUP_DIR=/home/user/telegram-auto-publisher/runtime/backups
MEDIA_CACHE_DIR=/home/user/telegram-auto-publisher/runtime/media_cache
LOG_DIR=/home/user/telegram-auto-publisher/runtime/logs

# --- Optional Default Telegram API Credentials (Can also be set from Web Dashboard) ---
TELEGRAM_DEFAULT_API_ID=
TELEGRAM_DEFAULT_API_HASH=
TELEGRAM_CATCHUP_LIMIT=100

# --- Worker, Album Aggregation & Retry Policy ---
WORKER_ID=tap-primary-worker
WORKER_POLL_INTERVAL_SECONDS=1.5
WORKER_STALE_LOCK_TIMEOUT_SECONDS=180
ALBUM_AGGREGATION_WINDOW_MS=2500
PUBLISH_MAX_ATTEMPTS=4
PUBLISH_RETRY_BASE_SECONDS=15
PUBLISH_RETRY_MAX_SECONDS=900
MEDIA_CACHE_RETENTION_HOURS=24
